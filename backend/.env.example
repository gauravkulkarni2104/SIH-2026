# Optional — the API works fully without these.
BHUVAN_API_TOKEN=
OPENTOPOGRAPHY_API_KEY=
ALLOWED_ORIGINS=https://sih-2026-1kjn.vercel.app,http://localhost:3000,http://localhost:5173

# Geometry providers, tried in this order at each search radius.
# If unset, the app falls back to OVERPASS_URL/OVERPASS_FALLBACK_URL, then to
# two public defaults, so nothing is required to get started.
OVERPASS_ENDPOINT_1=https://overpass-api.de/api/interpreter
OVERPASS_ENDPOINT_2=https://overpass.kumi.systems/api/interpreter
OVERPASS_ENDPOINT_3=

# Legacy variable names (still read if OVERPASS_ENDPOINT_* are all unset)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter

# Radius escalation ladder, in meters. Escalates only after a PROVIDER
# actually answers (empty or below-threshold) — never after a pure failure.
GEOMETRY_SEARCH_RADII=50,100,250
GEOMETRY_MATCH_THRESHOLD=0.80
OVERPASS_TIMEOUT_S=12

ULPIN_DATA_DIR=../data
